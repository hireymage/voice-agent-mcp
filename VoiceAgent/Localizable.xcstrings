          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuto: agent vás pozdraví při otevření aplikace a v každém novém rozhovoru, takže víte, že je vše načtené. Vypnuto: modelu se nic nepošle až do vaší první zprávy."
          }
        }
      }
