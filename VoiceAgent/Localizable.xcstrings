          }
        }
      }
    },
    "Apple voice returned no audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple voice returned no audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlas Apple nevrátil žádný zvuk."
          }
        }
      }
    },
    "Apple's Private Cloud Compute is not available in this app. Choose the on-device model in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's Private Cloud Compute is not available in this app. Choose the on-device model in Settings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud Compute od Applu v této aplikaci není dostupný. V Nastavení vyberte model on-device."
          }
        }
      }
    },
    "Apple's model does not work in this language yet. It supports: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model does not work in this language yet. It supports: %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple v tomto jazyce zatím nefunguje. Podporuje: %@."
          }
        }
      }
    },
    "Apple's model found no tool it could use among %d.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model found no tool it could use among %d."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple nenašel mezi %d nástroji žádný použitelný."
          }
        }
      }
    },
    "Apple's model is not available now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model is not available now."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple teď není dostupný."
          }
        }
      }
    },
    "Apple's model is not ready yet, it may still be downloading. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model is not ready yet, it may still be downloading. Try again later."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple ještě není připravený, možná se stahuje. Zkuste to později."
          }
        }
      }
    },
    "Apple's model needs iOS 26 or later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model needs iOS 26 or later."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple potřebuje iOS 26 nebo novější."
          }
        }
      }
    },
    "Apple's safety check stopped this reply. It can happen even with harmless text. Try saying it differently or use another model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's safety check stopped this reply. It can happen even with harmless text. Try saying it differently or use another model."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní kontrola Applu tuto odpověď zastavila. Může se to stát i u neškodného textu. Zkuste to říct jinak nebo použijte jiný model."
          }
        }
      }
    },
    "At the start of a conversation the model carries out the text above with the MCP tools, and what the tools return becomes the soul. If nothing loads, the conversation shows an error; there is no fallback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the start of a conversation the model carries out the text above with the MCP tools, and what the tools return becomes the soul. If nothing loads, the conversation shows an error; there is no fallback."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na začátku rozhovoru model splní text výše pomocí MCP nástrojů a to, co nástroje vrátí, se stane soulem. Když se nic nenačte, rozhovor ukáže chybu; náhradní soul není."
          }
        }
      }
    },
